{
  "name": "@raulrod/tokens",
  "version": "1.0.0",
  "description": "Design tokens for RaulRod UI: primitive, semantic and component layers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raulrod16124/raulrod-ui.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://raulrod16124.github.io/raulrod-ui/",
  "bugs": {
    "url": "https://github.com/raulrod16124/raulrod-ui/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./dist/styles.css.d.ts",
      "default": "./dist/tokens.css"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node tools/emit-css.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
