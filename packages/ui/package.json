{
  "name": "@raulrod/ui",
  "version": "0.1.2",
  "description": "React components for RaulRod UI (public entry point).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raulrod16124/raulrod-ui.git",
    "directory": "packages/ui"
  },
  "homepage": "https://raulrod16124.github.io/raulrod-ui/",
  "bugs": {
    "url": "https://github.com/raulrod16124/raulrod-ui/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./dist/styles.css.d.ts",
      "default": "./dist/styles.css"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node tools/copy-css.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@raulrod/icons": "workspace:*",
    "@raulrod/tokens": "workspace:*"
  },
  "devDependencies": {
    "@storybook/react": "^8.6.18",
    "@storybook/test": "^8.6.18",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.13.0",
    "happy-dom": "^20.14.5",
    "jest-axe": "^11.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  }
}
